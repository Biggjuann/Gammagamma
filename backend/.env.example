# Primary data source.
#   schwab     = Schwab Trader API via shared token endpoint (real-time, preferred)
#   marketdata = marketdata.app options chain API (EOD-cached; needs MARKETDATA_TOKEN)
#   databento  = OPRA.PILLAR via Databento (paid; needs DATABENTO_API_KEY)
#   yahoo      = Yahoo Finance options (free; IP-blocked on most data centers)
DATA_SOURCE=schwab
# Schwab shared-token endpoint: another service owns the refresh token
# and exposes a URL that returns a current access token.
SCHWAB_TOKEN_URL=https://other-service.example.com/schwab/token
SCHWAB_TOKEN_SHARE_KEY=replace-with-shared-secret
MARKETDATA_TOKEN=md-REPLACE-WITH-YOUR-TOKEN
# Optional: route marketdata.app through a static-IP proxy
# (Fixie, QuotaGuard, etc.) to bypass their single-device IP block.
# Example: MARKETDATA_PROXY_URL=http://user:pass@velodrome.usefixie.com:80
MARKETDATA_PROXY_URL=
DATABENTO_API_KEY=db-REPLACE-WITH-YOUR-KEY
RISK_FREE_RATE=0.0525
REFRESH_INTERVAL_SECONDS=60
TICKER_UNIVERSE=SPX,SPY,QQQ,ES,NQ
LOG_LEVEL=INFO
